{
	"name": "pi-arcane",
	"version": "0.1.0",
	"description": "Pi extension for develop → deploy workflows through Arcane",
	"private": true,
	"type": "module",
	"pi": {
		"extensions": ["./extension/index.ts"]
	},
	"dependencies": {
		"js-yaml": "^4.1.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.10.0",
		"typebox": "^1.3.13",
		"typescript": "^5.7.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test:smoke": "node --experimental-strip-types scripts/smoke.ts",
		"test:ws": "node --experimental-strip-types scripts/ws-test.ts",
		"test": "npm run typecheck && npm run test:smoke && npm run test:ws",
		"e2e": "node --experimental-strip-types scripts/e2e.ts"
	}
}
